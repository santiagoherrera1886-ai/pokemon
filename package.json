{
  "name": "alborada",
  "version": "1.0.0",
  "private": true,
  "description": "Alborada — aventura original de criaturas con estilo de portátil de doble pantalla, en el navegador y sin ROM.",
  "scripts": {
    "test": "node tests/e2e.cjs",
    "serve": "npx --yes http-server -p 8080 -c-1 .",
    "dev": "node scripts/build.cjs --vendor-only && node scripts/serve.cjs",
    "build": "node scripts/build.cjs",
    "test:unit": "node --test tests/*.test.mjs",
    "pretest": "node scripts/build.cjs --vendor-only",
    "test:graphics": "node scripts/build.cjs --vendor-only && node tests/graphics.cjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "type": "module"
}
